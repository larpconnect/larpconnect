# LarpConnect / Njall Docker Compose Local Environment Configuration
#
# Copy this file to .env to manually override development settings, or let
# `./gradlew composeStart` / `./gradlew composeUp` generate .env automatically.
#
# Master secret seed used to deterministically derive database role credentials:
#   - Migration: njall_migration_${NJALL_DB_SECRET}
#   - Admin:     njall_admin_${NJALL_DB_SECRET}
#   - Users:     njall_users_${NJALL_DB_SECRET}
#   - System:    njall_system_${NJALL_DB_SECRET}
#   - Engine:    postgres_${NJALL_DB_SECRET}
NJALL_DB_SECRET=example_seed_secret_for_local_testing_only

# Optional host port mappings
# POSTGRES_PORT=5433
# PORT=8080
